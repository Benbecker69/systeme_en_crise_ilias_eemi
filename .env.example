# Copy to .env and replace every "change-me" value.

# PostgreSQL
POSTGRES_DB=maintenancepro
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST_PORT=5433

# Login role used by Directus
DIRECTUS_DB_USER=directus_app
DIRECTUS_DB_PASSWORD=change-me

# Directus
DIRECTUS_PORT=8055
DIRECTUS_SECRET=change-me-long-random-string
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=change-me

# Demo accounts created by directus/setup.py
APP_MANAGER_EMAIL=manager@example.com
APP_MANAGER_PASSWORD=change-me
APP_TECH_PASSWORD=change-me

# pgAdmin
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=change-me
